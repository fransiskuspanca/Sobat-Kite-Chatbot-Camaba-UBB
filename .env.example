# Salin ke .env dan sesuaikan. JANGAN commit .env.
DJANGO_SECRET_KEY=ganti-dengan-nilai-acak-panjang
DB_NAME=chatbot
DB_USER=ubb
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# 1 = muat model saat startup. Fase 0/1 boleh 0.
MUAT_MODEL=1

# Menimpa config.json artefak Colab bila diisi.
# TAU_HIGH=0.72
# TAU_LOW=0.60

# --- Produksi ---
# Sentry untuk pelacakan exception (opsional; kosongkan untuk mematikan).
SENTRY_DSN=
SENTRY_ENV=produksi

# Redis: cache rate limit dibagi antar-worker.
REDIS_URL=redis://127.0.0.1:6379/1

# Lokasi backup & retensi (dipakai deploy/backup.sh)
BACKUP_DIR=/backup
RETENSI_HARI=30
